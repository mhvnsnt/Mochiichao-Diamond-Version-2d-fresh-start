{
  "$id": "mochiichao/biome-table.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Biome records (S2 Landing 3): a biome groups zones only, never species. displayName stays null until the owner authors it; weatherTable stays null until canon authors a rotation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "regionId": {
      "type": "string"
    },
    "biomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "biomeId": {
            "type": "string"
          },
          "zoneIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "weatherTable": {
            "type": [
              "string",
              "null"
            ]
          },
          "displayName": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "biomeId",
          "zoneIds",
          "weatherTable",
          "displayName",
          "status"
        ]
      }
    },
    "status": {
      "type": "string"
    }
  },
  "required": [
    "regionId",
    "biomes",
    "status"
  ]
}
