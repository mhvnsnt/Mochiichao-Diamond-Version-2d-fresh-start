  "npcs": [{"id": "dojo1_guard", "x": 14, "y": 9, "name": "Dojo Acolyte", "role": "npc", "dialog": ["Master Lin is in. Mind the floorboards — every part of this dojo has a place, and so will you, briefly.", "His custom: he sets the order, you find where you fit. The chalk marks by the gate are the last hundred who fit wrong. Kidding. Half of them are mine."], "dialogAfter": ["You fit. The Core Fragment sits heavy, doesn't it? Next road's the Forest — Aero Dojo, Wind Wing. Falk doesn't ask permission, so I am asking for him: be ready."]}, {"id": "town_lass", "x": 10, "y": 20, "name": "Town Girl", "role": "npc"}, {"id": "town_oldman", "x": 23, "y": 12, "name": "Old Man", "role": "npc"}],
