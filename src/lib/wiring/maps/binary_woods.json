  "npcs": [{"id": "hacker_grunt2", "x": 13, "y": 10, "name": "Hacker Grunt", "role": "trainer", "dialog": ["You're off the path. The path is a courtesy. The Forest underneath it is the real map, and it isn't yours.", "We log what the hum carries. Every step, every call, every little creature secret. Data's just memory that hasn't been read yet.", "Walk loud if you like. Reading you is not the hard part."], "battleDialog": {"intro": "A walker with a full bag. The Forest logs everything that passes — I just do the reading for it.", "defeat": "…Reading's done. The docks rotation changes at six — tell nobody I needed the reminder.", "after": "Go on, then. Loud as you like. Volume was never the variable."}}, {"id": "trainer_bugcatcher_mira", "x": 9, "y": 20, "name": "Bug Catcher Mira", "role": "trainer", "battleDialog": {"intro": "Shh — you're scaring the small ones. Battle me quick and quiet, and I'll show you which log the Kittember naps under.", "defeat": "Loud AND strong. The small ones are taking notes. So am I, and mine are in pencil.", "after": "The hum goes thin past the Echoes door — even the bugs walk softer there. If your light's ready, the cave is the kind dark. If it isn't, the Forest will lend you its edge. Walk it slow."}}, {"id": "trainer_woodswalker_tess", "x": 21, "y": 15, "name": "Woods Walker Tess", "role": "trainer", "battleDialog": {"intro": "You walk loud. The whole path heard you at the gate. My Kittember and I will be your volume lesson.", "defeat": "Ha. Even losing, we lost quiet.", "after": "Her flame burns at the tail's tip and nowhere else. The hum likes her. When the hum likes somebody, the Forest walks them home — remember that on your way out, loud one."}}],
  "signs": [{"x": 30, "y": 17, "text": "THE DARK FOREST\nThe woods hum. Walk slow.\nIf the humming stops, you stop."}],
  "wildPool": ["Kittember"]
}
