# Mochiichao house OpenColorIO config v1 - 2026-10-28.
#
# What this config is: the transform half of the house colour discipline
# (show/bible/COLOR-SYSTEM.md + show/bible/LIGHTING-SYSTEM.md), written as
# the industry-standard colour-management config the composite stage
# already names as its working path (show/production/UNIFIED-PIPELINE.md:
# "linear/ACES via OpenColorIO in Natron, 32-bit float").
#
# What it enforces, mechanically:
#   LS-1/LS-2 (protected identity colours are never re-hued):
#     Protected plates are assigned the DATA colorspace
#     "Protected Identity - Data". OCIO never colour-transforms data, so
#     no view, look or conversion in this config can tint them. The
#     protection is architectural (which colorspace a layer travels in),
#     not a LUT - a config cannot mask layers by itself, and this one
#     does not pretend to. Layer discipline stays a lighting-sheet gate
#     item (LIGHTING-SYSTEM.md section 8.2); this config makes the
#     protected path transform-proof once a layer is on it.
#   LS-2 (environment colour lives on atmosphere/rims only):
#     Environment colour exists ONLY as named Looks below, applied to
#     environment/atmosphere layers in the comp graph - never to layers
#     travelling as data.
#   LS-7 (shifts are overlays): a shift is a Look selection on the
#     environment layers; removing it returns the base exactly.
#
# Protected reference values (COLOR-SYSTEM.md): ink #101010, accent red
# #a03436 (quarantined - no Look in this config may produce it; the two
# Looks below are field tints with small CDL moves, checked in
# check_config.py), subtitle card #d0f0f0.
#
# Validate with: python3 check_config.py   (requires the opencolorio
# Python package - a tool install, not a pipeline dependency.)

ocio_profile_version: 2

environment: {}

search_path: ""
strictparsing: true
luma: [0.2126, 0.7152, 0.0722]
description: Mochiichao house colour config - ACES working space, protected identity as data, environment colour as looks only.

file_rules:
  - !<Rule> {name: Default, colorspace: sRGB - Texture}

roles:
  scene_linear: ACEScg
  reference: ACES2065-1
  default_byte: sRGB - Texture
  default_float: ACEScg
  data: Protected Identity - Data
  color_picking: sRGB - Texture
  matte_paint: ACEScg
  texture_paint: sRGB - Texture

displays:
  sRGB:
    - !<View> {name: Show, colorspace: sRGB - Display}
    - !<View> {name: Show - Gate Night Env Tint, colorspace: sRGB - Display, look: ENV - Cool Night Field}
    - !<View> {name: Show - Gate Dusk Env Tint, colorspace: sRGB - Display, look: ENV - Warm Dusk Field}
    - !<View> {name: Protected Check (Data), colorspace: Protected Identity - Data}
    - !<View> {name: Scene Linear (ACEScg), colorspace: ACEScg}

active_displays: [sRGB]
active_views: [Show, Protected Check (Data), Scene Linear (ACEScg)]

looks:
  - !<Look>
    name: ENV - Cool Night Field
    process_space: ACEScg
    description: Environment/atmosphere layers ONLY (LS-2). Cool field tint for GATE-NIGHT class keys (LIGHTING-SYSTEM.md section 3). Never applied to protected layers.
    transform: !<CDLTransform> {slope: [0.90, 0.97, 1.14], offset: [0.0, 0.004, 0.018], power: [1.0, 1.0, 1.0], sat: 0.92}

  - !<Look>
    name: ENV - Warm Dusk Field
    process_space: ACEScg
    description: Environment/atmosphere layers ONLY (LS-2). Warm field tint for GATE-DUSK class keys (LIGHTING-SYSTEM.md section 3). Never applied to protected layers.
    transform: !<CDLTransform> {slope: [1.10, 1.0, 0.86], offset: [0.008, 0.002, 0.0], power: [1.0, 1.0, 1.0], sat: 1.03}

colorspaces:
  - !<ColorSpace>
    name: ACES2065-1
    family: aces
    equalitygroup: ""
    bitdepth: 32f
    description: Scene reference (AP0 linear). Interchange/archive only; nobody paints here.
    isdata: false
    allocation: lg2
    allocationvars: [-8, 5, 0.00390625]

  - !<ColorSpace>
    name: ACEScg
    family: working
    equalitygroup: ""
    bitdepth: 32f
    description: Working space (AP1 linear). Composite happens here - Natron 32-bit float per UNIFIED-PIPELINE.
    isdata: false
    allocation: lg2
    allocationvars: [-8, 5, 0.00390625]
    to_scene_reference: !<BuiltinTransform> {style: ACEScg_to_ACES2065-1}

  - !<ColorSpace>
    name: sRGB - Display
    family: display
    equalitygroup: ""
    bitdepth: 32f
    description: sRGB display rendering via the ACES 1.0 SDR video output transform.
    isdata: false
    allocation: uniform
    allocationvars: [0, 1]
    from_scene_reference: !<GroupTransform>
      children:
        - !<BuiltinTransform> {style: "ACES-OUTPUT - ACES2065-1_to_CIE-XYZ-D65 - SDR-VIDEO_1.0"}
        - !<BuiltinTransform> {style: "DISPLAY - CIE-XYZ-D65_to_sRGB"}

  - !<ColorSpace>
    name: sRGB - Texture
    family: input
    equalitygroup: ""
    bitdepth: 32f
    description: Display-referred sRGB plates/textures entering the scene reference.
    isdata: false
    allocation: uniform
    allocationvars: [0, 1]
    to_scene_reference: !<GroupTransform>
      children:
        - !<BuiltinTransform> {style: "DISPLAY - CIE-XYZ-D65_to_sRGB", direction: inverse}
        - !<BuiltinTransform> {style: "UTILITY - ACES-AP0_to_CIE-XYZ-D65_BFD", direction: inverse}

  - !<ColorSpace>
    name: Protected Identity - Data
    family: data
    equalitygroup: ""
    bitdepth: 32f
    description: DATA - no transform is ever applied by any OCIO process. Protected identity plates (LS-1/LS-2 - model-sheet fills, mask-white, ink, subtitle cards) travel in this colorspace end to end.
    isdata: true
