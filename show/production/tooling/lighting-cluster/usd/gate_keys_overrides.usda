#usda 1.0
(
    subLayers = [@./gate_keys.usda@]
    doc = "Opinion-layer example (LS-7 in USD terms): an episode-level override that strengthens the GATE-DUSK rim for one scene WITHOUT editing the base keys file. Composition: this layer is stronger than gate_keys.usda, so its opinions win where both speak; the base stays untouched and removing this layer restores the base exactly - the USD form of 'shifts are overlays, never repaints'."
)

over "GardenGateLightingKeys"
{
    over "GATE_DUSK"
    {
        custom string mochiichao:overrideReason = "Example opinion: dusk stakeout readability - rim strengthened for one scene; base key unchanged."
        over "RimLight"
        {
            float inputs:intensity = 2.1
        }
    }
}
