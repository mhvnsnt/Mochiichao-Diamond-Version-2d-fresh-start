            color3f inputs:color = (1, 0.88, 0.68)
            float inputs:colorTemperature = 4300
            bool inputs:enableColorTemperature = true
            float inputs:intensity = 3
            double3 xformOp:rotateXYZ = (-58, -35, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }

        def DomeLight "FillLight"
        {
            color3f inputs:color = (0.78, 0.86, 1)
            float inputs:intensity = 1.1
        }

