#usda 1.0
(
    defaultPrim = "GardenGateLightingKeys"
    metersPerUnit = 1
    upAxis = "Y"
    doc = "Mochiichao house lighting keys for the Garden Gate, expressed as OpenUSD scene data. Source of truth for the words: show/bible/LIGHTING-SYSTEM.md section 3 (Garden Gate). Each key is data, not a render: one motivated key light (LS-5), a fill, and a rim, plus the sheet fields as custom attributes. Lighting states are overlay parameters (LS-7) - this stage is the base data an overlay is built from, never a repaint of protected colour (LS-1/LS-2). Light orientation is nominal (x = screen right, y = up) and encodes the sheet's stated screen direction for any future plate work; intensities are relative, not photometric."
)

def Xform "GardenGateLightingKeys"
{
    custom string mochiichao:location = "Garden Gate"
    custom string mochiichao:sourceDoc = "show/bible/LIGHTING-SYSTEM.md"
    custom string mochiichao:sourceSection = "3 - Garden Gate"

    def Xform "GATE_MORNING"
    {
        custom string mochiichao:keyToken = "GATE-MORNING"
        custom string mochiichao:keyName = "First Bell"
        custom string mochiichao:keySource = "low warm sun, screen-left"
        custom string mochiichao:fill = "bright sky bounce, low ratio (high-key)"
        custom float mochiichao:fillToKey = 0.37
        custom string mochiichao:rim = "pale gold on edges facing the lane"
        custom string mochiichao:rimDuty = "standard"
        custom bool mochiichao:rimMandatoryOnDarkCast = false
        custom float mochiichao:temperatureFeelK = 4300
        custom string mochiichao:gradeFamily = "Signature Day"
        custom string mochiichao:shiftModel = "overlay (LS-7)"
        custom string mochiichao:note = "The show's home key: honest, welcoming, everything readable."

