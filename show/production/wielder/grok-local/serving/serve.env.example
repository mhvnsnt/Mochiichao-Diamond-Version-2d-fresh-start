# Copy to serve.env and fill in. serve.env itself is never committed
# (it holds the endpoint key) — this example is the shape only.

# The endpoint's API key. Anyone holding it can use the seat, so on
# any internet-reachable deployment this is the lock on the door.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GROK_LOCAL_API_KEY=

# Which model variant to serve: primary | fallback | free-seat |
# primary-abliterated | fallback-abliterated | custom
MODEL_VARIANT=primary

# Where the weights live (default ./models/<variant> — pull_model.py
# and quantize_awq.py write there).
# MODEL_DIR=

# Optional overrides (defaults per variant are set in launch.sh).
# PORT=8000
# MAX_MODEL_LEN=
# GPU_MEMORY_UTILIZATION=

# Hugging Face token — needed ONLY for the gated fallback
# abliterated source (huihui-ai/Qwen3-32B-abliterated sits behind a
# one-time usage-warning acceptance on the HF website).
# HF_TOKEN=
