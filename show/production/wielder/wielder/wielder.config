{"_about":"WIELDER defaults — the opposite-defaults constitution as configuration. These are Wielder's defaults, not any library's: Wielder reads this file at startup (wielder/constitution.py) and the graph, tool layer and report generator take their hard limits from it.","advisory_critic_retry_cap":3,"budgets":{"max_steps_per_run":40,"max_wall_seconds_per_run":1800},"default_deny_completion":true,"inter_agent_messages":"schema-json-only","owner_gate":"langgraph interrupt — the run pauses durably and resumes only on the owner's recorded verdict","owner_standards":{"current_version_law":true,"grading_law_wrong_character_is_fail":true,"no_baked_shadows":true,"no_idle_on_approval":true,"staging_law":true},"pass_issuer":"finish-gate verifier manifest only","raw_shell_allowed":false,"retrieval_rule":"top-k hydration only; whole-corpus prompt dumps forbidden (lost-in-the-middle)","retrieval_top_k":3,"schema_only_tools":true,"scorer_separation":"wielder has no write path to finish-gate gates/methods/targets/goldens/evidence","stop_on_fail":true,"wip_limit":1}