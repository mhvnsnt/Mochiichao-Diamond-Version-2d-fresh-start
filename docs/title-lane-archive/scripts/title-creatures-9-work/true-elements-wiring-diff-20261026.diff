+ * in battleResolver/battle-math and are unchanged by this diff.
+ * Deep: no legacy type maps to Deep, so no Gen 1 lookup can hit a
+ * TBD cell; a Deep lookup (Gen 2+) flags typeChartMissing in the
+ * resolver and plays x1 until Mars rules Deep's matchups.
+ */
+export function buildTrueMoveTable(): MoveTable {
+  const moves: MoveTable['moves'] = {};
+  for (const [id, m] of Object.entries(MOVES_DB)) {
+    const rm = legacyMoveToResolverMove(id, m);
+    moves[id] = { ...rm, type: LEGACY_TO_TRUE_ELEMENT[m.type] ?? m.type };
+  }
+  return { moves };
+}
+
+export function mapSpeciesTypesToTrue(types: string[]): string[] {
+  return types.map((t) => LEGACY_TO_TRUE_ELEMENT[t] ?? t);
+}
+
+export function makeTrueResolverBattler(
+  side: 'player' | 'foe',
+  inst: MochiiInstance,
+  speciesTypes: string[],
+  carried: CarriedBattlerState,
+): ResolverBattler {
+  return makeResolverBattler(side, inst, mapSpeciesTypesToTrue(speciesTypes), carried);
+}
